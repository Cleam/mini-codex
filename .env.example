# ---------------------------------------------------------------------------
# LLM 配置
#
# 本项目统一走 OpenAI 兼容协议（Chat Completions + tools）。
# 切换模型只需要改下面三个变量，不需要改任何代码——
# 这是"支持多模型"的最小实现方式，避免为此引入 Provider 抽象层。
#
# 复制本文件为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实 Key。
# ---------------------------------------------------------------------------

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---------------------------------------------------------------------------
# 常见供应商示例（model 名称请以各家最新文档为准，下面只是形态示意）
#
#   OpenAI 官方
#     LLM_BASE_URL=https://api.openai.com/v1
#
#   DeepSeek
#     LLM_BASE_URL=https://api.deepseek.com/v1
#
#   OpenRouter（一个 Key 转发到多家模型，切模型只改 LLM_MODEL）
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#
#   Anthropic 的 OpenAI 兼容端点
#     LLM_BASE_URL=https://api.anthropic.com/v1
#
#   本地 Ollama
#     LLM_BASE_URL=http://localhost:11434/v1
#     注意：小参数量模型的 Tool Calling 稳定性较差，
#     经常出现不调用工具或参数不符合 Schema，仅适合离线调试，
#     不适合用来判断"我的代码写得对不对"。
# ---------------------------------------------------------------------------
